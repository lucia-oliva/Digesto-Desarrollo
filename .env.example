# Copiar este archivo a `.env` y ajustar valores si es necesario.

# Credenciales de la base de datos (usadas por el servicio db y el backend)
DB_NAME=bs_digesto
DB_USER=digesto
DB_PASS=digesto
MARIADB_ROOT_PASSWORD=root

# Puertos publicados en el host (cambiar si están ocupados)
# 3306 suele estar ocupado por un MySQL/MariaDB local; usar 3307 si es el caso
MARIADB_PORT=3307
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Backend
FRONT_ORIGINS=http://localhost:5173
ACCESS_SECRET=cambiar-access-secret
REFRESH_SECRET=cambiar-refresh-secret

# Mail (opcional; se usa solo al enviar correos de contacto)
MAIL_USER=
MAIL_PASS=

# Frontend (true en Docker Desktop/Windows si no se reflejan los cambios)
CHOKIDAR_USEPOLLING=false