
# ==================================================
# DIGESTO - CONFIGURACION DEL ENTORNO PARA DOCKER
# ==================================================
# Copiar este archivo como .env y completar los valores.
# Si no se usa Docker usar Backend./env.example en su lugar. 

# ==================================================
# BASE DE DATOS
# ==================================================
# Configuracion de MariaDB utilizada por Docker Compose.
# Usar los datos correspondientes al entorno.

DB_NAME=[bs_digesto] - Uso para Dump de BD
DB_USER=REEMPLAZAR_USUARIO_BD
DB_PASS=REEMPLAZAR_CLAVE_BD
MARIADB_ROOT_PASSWORD=REEMPLAZAR_CLAVE_ROOT


# ==================================================
# PUERTOS (Sugeridos) - LOCAL
# ==================================================
MARIADB_PORT=3307
BACKEND_PORT=3000
FRONTEND_PORT=5173


# ==================================================
# BACKEND - LOCAL
# ==================================================
# En produccion, utilizar la URL correspondiente.

FRONT_ORIGINS=http://localhost:5173

# Secrets para autenticacion JWT.

ACCESS_SECRET=REEMPLAZAR_SECRETO_ACCESS
REFRESH_SECRET=REEMPLAZAR_SECRETO_REFRESH


# ==================================================
# FORMULARIO DE CONTACTO - SMTP
# ==================================================
# Cuenta utilizada para enviar los mensajes. (Institucional - SOLO GMAIL)
MAIL_USER=
MAIL_PASS=

# ==================================================
# FORMULARIO DE CONTACTO - DESTINATARIOS
# ==================================================
# Direcciones autorizadas para recibir consultas.

CONTACT_RECIPIENT_APLICADAS=
CONTACT_RECIPIENT_EXACTAS=
CONTACT_RECIPIENT_SALUD=
CONTACT_RECIPIENT_SOCIALES=
CONTACT_RECIPIENT_HUMANAS=
CONTACT_RECIPIENT_CONSEJO_SUPERIOR=
CONTACT_RECIPIENT_CHEPES=
CONTACT_RECIPIENT_CATUNA=
CONTACT_RECIPIENT_AIMOGASTA=
CONTACT_RECIPIENT_CHAMICAL=
CONTACT_RECIPIENT_VILLA_UNION=


# ==================================================
# FORMULARIO DE CONTACTO - CLOUDFLARE TURNSTILE
# ==================================================
# Site Key: publica, utilizada por el frontend.
# Secret Key: privada, utilizada solo por el backend.
# Hostname: dominio autorizado para el formulario.

VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Tiempo maximo de verificacion en milisegundos.
TURNSTILE_TIMEOUT_MS=5000


# ==================================================
# FORMULARIO DE CONTACTO - RATE LIMITING
# ==================================================
# Limite de solicitudes por direccion IP.
# Configuracion actual: 5 solicitudes cada 15 minutos.

CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# ==================================================
# FRONTEND - API LOCAL
# ==================================================
VITE_API_BASE_URL=http://localhost:3000/api

# Activar en Docker Desktop/Windows si los cambios
# del frontend no se reflejan automaticamente.
CHOKIDAR_USEPOLLING=false
