# Copiar este archivo a `.env` y ajustar valores si es necesario.

# Credenciales de la base de datos (usadas por el servicio db y el backend)
DB_NAME=bs_digesto
DB_USER=digesto
DB_PASS=digesto
MARIADB_ROOT_PASSWORD=root

# Puertos publicados en el host (cambiar si están ocupados)
# 3306 suele estar ocupado por un MySQL/MariaDB local; usar 3307 si es el caso
MARIADB_PORT=3307
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Backend
FRONT_ORIGINS=http://localhost:5173
ACCESS_SECRET=cambiar-access-secret
REFRESH_SECRET=cambiar-refresh-secret

# Cuenta SMTP institucional remitente. Nunca se expone al frontend.
MAIL_USER=
MAIL_PASS=

# Un único buzón institucional autorizado por dependencia.
CONTACT_RECIPIENT_APLICADAS=
CONTACT_RECIPIENT_EXACTAS=
CONTACT_RECIPIENT_SALUD=
CONTACT_RECIPIENT_SOCIALES=
CONTACT_RECIPIENT_HUMANAS=
CONTACT_RECIPIENT_CONSEJO_SUPERIOR=
CONTACT_RECIPIENT_CHEPES=
CONTACT_RECIPIENT_CATUNA=
CONTACT_RECIPIENT_AIMOGASTA=
CONTACT_RECIPIENT_CHAMICAL=
CONTACT_RECIPIENT_VILLA_UNION=

# Cloudflare Turnstile. La site key es pública; la secret key solo va al backend.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_TIMEOUT_MS=5000

# Rate limiting del formulario de contacto.
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api
# true en Docker Desktop/Windows si no se reflejan los cambios.
CHOKIDAR_USEPOLLING=false