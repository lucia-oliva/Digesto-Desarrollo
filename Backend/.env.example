
# ==================================================
# DIGESTO - CONFIGURACION DEL BACKEND (SIN DOCKER)
# ==================================================
# Copiar este archivo como Backend/.env 
# Con Docker Compose se utiliza el .env de la raiz.


# ==================================================
# BASE DE DATOS - MariaDB
# ==================================================
# DB_HOST corresponde a la direccion del servidor.
# El backend utiliza el puerto 3306 por defecto.

DB_HOST=REEMPLAZAR_HOST_BD
DB_USER=REEMPLAZAR_USUARIO_BD
DB_PASS=REEMPLAZAR_CLAVE_BD
DB_NAME=[bs_digesto] - Uso para Dump de BD


# ==================================================
# SERVIDOR Y ACCESO
# ==================================================
# Configuracion sugerida para desarrollo local.

NODE_ENV=development
PORT=3000
FRONT_ORIGINS=http://localhost:5173


# ==================================================
# AUTENTICACION
# ==================================================
ACCESS_SECRET=REEMPLAZAR_SECRETO_ACCESS
REFRESH_SECRET=REEMPLAZAR_SECRETO_REFRESH

# ==================================================
# FORMULARIO DE CONTACTO - SMTP (SOLO GMAIL)
# ==================================================
MAIL_USER=
MAIL_PASS=

# ==================================================
# FORMULARIO DE CONTACTO - DESTINATARIOS
# ==================================================

CONTACT_RECIPIENT_APLICADAS=
CONTACT_RECIPIENT_EXACTAS=
CONTACT_RECIPIENT_SALUD=
CONTACT_RECIPIENT_SOCIALES=
CONTACT_RECIPIENT_HUMANAS=
CONTACT_RECIPIENT_CONSEJO_SUPERIOR=
CONTACT_RECIPIENT_CHEPES=
CONTACT_RECIPIENT_CATUNA=
CONTACT_RECIPIENT_AIMOGASTA=
CONTACT_RECIPIENT_CHAMICAL=
CONTACT_RECIPIENT_VILLA_UNION=

# ==================================================
# FORMULARIO DE CONTACTO - CLOUDFLARE TURNSTILE
# ==================================================
# Secret Key: clave privada de verificacion.
# Hostname: dominio autorizado, sin protocolo ni ruta.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# Tiempo maximo de verificacion en milisegundos.
TURNSTILE_TIMEOUT_MS=5000
# ==================================================
# FORMULARIO DE CONTACTO - RATE LIMITING
# ==================================================
# Limite de solicitudes por direccion IP.
# Configuracion actual: 5 solicitudes cada 15 minutos.
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
